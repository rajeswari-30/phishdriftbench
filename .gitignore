.venv/
__pycache__/
*.pyc
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# The shipped demo model IS committed (~1.2 MB): without it a fresh clone has
# the code but no working demo, and reproducing it means an ~8-minute retrain
# plus the raw corpora, which are not redistributable here. The *_backup/
# directories stay ignored -- they are local rollback points, not artifacts a
# cloner needs.
!data/processed/demo_model/
results/*
!results/.gitkeep
*.egg-info/
.DS_Store
.pytest_cache/
catboost_info/
reference_papers/
paper/*.log
paper/*.blg
paper/*.aux
paper/*.out
paper/*.toc
.claude/settings.local.json
.claude/scheduled_tasks.lock
