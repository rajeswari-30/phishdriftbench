{
  "manifest_version": 3,
  "name": "PhishLens — URL Phishing Checker",
  "version": "1.0.0",
  "description": "Lightweight, explainable phishing URL detection. Right-click any link to check it, or open the popup to check the current page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "activeTab", "storage", "notifications", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:5001/*",
    "http://localhost:5001/*"
  ]
}
